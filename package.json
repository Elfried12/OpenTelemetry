{
  "name": "@backend-conception/events-day2",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --hot src/bootstrap.ts",
    "start": "bun src/bootstrap.ts",
    "check": "bun run format:check && bun run lint && tsc --noEmit",
    "test": "bun test ./test",
    "test:application": "bun test ./test/application",
    "test:transports": "bun test ./test/transports.test.ts",
    "test:contract": "bun test ./test/event-repository.test.ts",
    "demo:export": "bun scripts/export-demo-requests.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c .oxlintrc.json src test scripts",
    "lint:fix": "oxlint -c .oxlintrc.json --fix src test scripts"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.12.17",
    "@valibot/to-json-schema": "^1.8.0",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.3",
    "hono-openapi": "^1.5.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "uuid": "14.0.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.23.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "testcontainers": "^12.2.1",
    "typescript": "^5.9.3"
  }
}
