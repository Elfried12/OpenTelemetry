DATABASE_URL=postgres://events:events@localhost:55432/events
POSTGRES_PORT=55432
POSTGRES_DB=events
POSTGRES_USER=events
POSTGRES_PASSWORD=events
# Write-side adapter: postgres, kysely, drizzle, valkey or valkey-functional.
# Event queries always use a separate Valkey read model in the running API.
EVENT_REPOSITORY=postgres
VALKEY_URL=redis://localhost:56379
VALKEY_PORT=56379
ADMINER_PORT=8080
PORT=3000
# Required. Generate with: openssl rand -hex 32
APPLICATION_SECRET_KEY=
